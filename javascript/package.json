{
  "name": "bangla-ai",
  "version": "0.3.0",
  "description": "AI-powered NLP toolkit for the Bengali language",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./text": "./src/text/index.js"
  },
  "bin": {
    "bangla-ai": "bin/bangla-ai.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "example": "node examples/basic_usage.js"
  },
  "files": ["src", "bin", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["bengali", "bangla", "nlp", "ai", "summarization", "sentiment", "huggingface", "openai"],
  "author": "LXNotes <hello@lxnotes.com>",
  "license": "MIT",
  "homepage": "https://github.com/ruhulaminpro/bangla-ai-toolkit#readme",
  "bugs": {
    "url": "https://github.com/ruhulaminpro/bangla-ai-toolkit/issues"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "@huggingface/inference": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true },
    "@huggingface/inference": { "optional": true }
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruhulaminpro/bangla-ai-toolkit.git"
  }
